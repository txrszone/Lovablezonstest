PORT=3000
API_KEY=change-this-to-a-long-random-secret

# The real Lovable project chat endpoint must be supplied here.
# Example shape only; do not copy this value blindly.
LOVABLE_CHAT_URL_TEMPLATE=https://YOUR-UPSTREAM-HOST/projects/{projectId}/chat

# Optional: if your upstream requires a fixed extra header.
UPSTREAM_API_KEY=

# Set to true only while debugging.
DEBUG=false
